/* ===== DARK THEME ===== */

QMainWindow, QDialog, QWidget {
	background-color: #191919;
	color: #ffffff;
}

QPushButton {
	background-color: #3d3d3d;
	color: #ffffff;
	border: 1px solid #555555;
}
QPushButton:disabled{
	color: #7d7a75;
}
QPushButton:hover {
	background-color: #2c2c2c;
}
QPushButton:pressed {
	background-color: #474747;
}
QPushButton[type="sidebarButton"] {
	color: #9B9A97;
	background-color: transparent;
	border: none;
}
QPushButton[type="sidebarButton"]:hover {
	background-color: #2c2c2c;
}
QPushButton[type="iconButton"] {
	background-color: transparent;
	border: none;
}
QPushButton[type="iconButton"]:hover {
	background-color: #2c2c2c;
}
QPushButton[type="iconButton"]:pressed {
	background-color: #474747;
}

QPushButton#home {
	qproperty-icon: url("assets/home-dark.ico");
	background-color: #373735;
	color: #ffffff;
	border: none;
}

QLabel {
	color: #ffffff;
	background-color: transparent;
}
QLabel[type="sidebar-title"] {
	color: #9B9A97;
}
QLabel[type="path"] {
	color: #787878;
	background-color: transparent;
}

QMenu {
	background-color: #2b2b2b;
	color: #ffffff;
	border: 1px solid #555555;
}
QMenu::item:selected {
	background-color: #444444;
}

QListWidget {
	background: transparent;
	color: #9B9A97;
	border: none;
}
QListWidget[type="trash-page"] {
	color: #ffffff;
}
QListWidget::item:hover {
	background-color: #2c2c2c;
}
QListWidget::item:selected {
	background-color: #444444;
	color: #ffffff;
}

QComboBox {
	background-color: #3d3d3d;
	color: #ffffff;
	border: 1px solid #555555;
	border-radius: 6px;
	padding: 4px 8px;
}
QComboBox:hover {
	border-color: #2c2c2c;
}
QComboBox QAbstractItemView {
	background-color: #3d3d3d;
	color: #ffffff;
	selection-background-color: #555555;
	border: 1px solid #555555;
}
QComboBox::drop-down {
	border: none;
}

QLineEdit {
	background-color: #3d3d3d;
	color: #ffffff;
	border: 1px solid #555555;
	border-radius: 4px;
	padding: 4px 8px;
}
QLineEdit[type="chapter-title"] {
	background: transparent;
	border: none;
	color: #ffffff;
}
QLineEdit[type="input-dialog"] {
	background: transparent;
	border: none;
	border-bottom: 1px solid #9B9A97;
	color: #ffffff;
}
QLineEdit[type="input-dialog"]:focus {
	border-bottom: 1px solid #FFFFFF;
}

QPlainTextEdit {
	background-color: #2b2b2b;
	color: #ffffff;
	border: 1px solid #555555;
	border-radius: 4px;
}
QPlainTextEdit[type="text-edit"] {
	background: transparent;
	border: none;
	color: #ffffff;
}

QScrollBar:vertical {
	background-color: #2b2b2b;
	width: 8px;
}
QScrollBar::handle:vertical {
	background-color: #555555;
	border-radius: 4px;
	min-height: 20px;
}
QScrollBar::handle:vertical:hover {
	background-color: #2c2c2c;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
	height: 0px;
}

QSplitter::handle {
	background-color: #424242;
}
QSplitter::handle:hover {
	background-color: #2c2c2c;
}
QSplitter::handle:pressed {
	background-color: #474747;
}

ViewSidebar {
	background-color: #202020;
}

ViewReviewTag {
	border: 1px solid #424242;
}
ViewReviewTag:hover {
	background-color: #2c2c2c;
}
ViewReviewTag:pressed {
	background-color: #333333;
}

QuestionEdit {
	border: 1px solid #555555;
	background: transparent;
}

QCheckBox {
	color: #ffffff;
}

QPushButton#add-new-note {
	background-color: #333333;
	color: #ffffff;
}
QPushButton#add-new-note:hover {
	background-image: url("assets/add-note-bg-dark.jpg");
}
