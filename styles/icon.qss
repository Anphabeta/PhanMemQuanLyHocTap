QPushButton#home{
	qproperty-iconSize: 20px 20px;
	font-size: 20px;
	border-radius: 16px;
}
QPushButton#new{
	qproperty-icon: url("assets/new.svg");
	qproperty-iconSize: 16px 16px;
}
