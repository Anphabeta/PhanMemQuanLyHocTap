QPushButton#add-new-note{
    height: 64px;
    min-height: 64px;
    max-height: 64px;
    width: 100%;
	background-image: url("assets/add-note-bg.jpg");
	background-repeat: no-repeat;
	background-position: center;

	border: none;
	background-color: #333333;
	color: #ffffff;

	qproperty-icon: url("assets/add-note.svg");
	qproperty-iconSize: 16px 16px;

	font-size:16px;
}
QPushButton#add-new-note:hover {
    background-image: url("assets/add-note-bg-dark.jpg");
}
