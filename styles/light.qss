QMainWindow, QDialog, QWidget {
	background-color: #ffffff;
	color: #1a1a1a;
}

QPushButton {
	background-color: #e0e0e0;
	color: #1a1a1a;
	border: 1px solid #c0c0c0;
}
QPushButton:disabled{
	color: #ada9a3;
}
QPushButton:hover {
	background-color: #f1f0ef;
}
QPushButton:pressed {
	background-color: #bbbbbb;
}
QPushButton[type="sidebarButton"] {
	color: #9b9a97;
	background-color: transparent;
	border: none;
}
QPushButton[type="sidebarButton"]:hover {
	background-color: #f1f0ef;
}
QPushButton[type="iconButton"] {
	background-color: transparent;
	border: none;
}
QPushButton[type="iconButton"]:hover {
	background-color: #f1f0ef;
}
QPushButton[type="iconButton"]:pressed {
	background-color: #bbbbbb;
}

QPushButton#home {
	qproperty-icon: url("assets/home-light.svg");
	background-color: #eae8e6;
	color: #000000;
	border: none;
}

QLabel {
	color: #1a1a1a;
	background-color: transparent;
}
QLabel[type="sidebar-title"] {
	color: #9b9a97;
}
QLabel[type="path"] {
	color: #888888;
	background-color: transparent;
}

QMenu {
	background-color: #ffffff;
	color: #1a1a1a;
	border: 1px solid #c0c0c0;
}
QMenu::item:selected {
	background-color: #e0e0e0;
}

QListWidget {
	background-color: #f5f5f5;
	color: #9b9a97;
	border: none;
}
QListWidget[type="trash-page"] {
	color: #1a1a1a;
}
QListWidget::item:hover {
	background-color: #f1f0ef;
}
QListWidget::item:selected {
	background-color: #d0d0d0;
	color: #1a1a1a;
	border: none;
}

QComboBox {
	background-color: #ffffff;
	color: #1a1a1a;
	border: 1px solid #c0c0c0;
	border-radius: 6px;
	padding: 4px 8px;
}
QComboBox:hover {
	border-color: #f1f0ef;
}
QComboBox QAbstractItemView {
	background-color: #ffffff;
	color: #1a1a1a;
	selection-background-color: #e0e0e0;
	border: 1px solid #c0c0c0;
}
QComboBox::drop-down {
	border: none;
}

QLineEdit {
	background-color: #ffffff;
	color: #1a1a1a;
	border: 1px solid #c0c0c0;
	border-radius: 4px;
	padding: 4px 8px;
}
QLineEdit[type="chapter-title"] {
	background: transparent;
	border: none;
	color: #1a1a1a;
}
QLineEdit[type="input-dialog"] {
	background: transparent;
	border: none;
	border-bottom: 1px solid #999999;
	color: #1a1a1a;
}
QLineEdit[type="input-dialog"]:focus {
	border-bottom: 1px solid #333333;
}

QPlainTextEdit {
	background-color: #ffffff;
	color: #1a1a1a;
	border: 1px solid #c0c0c0;
	border-radius: 4px;
}
QPlainTextEdit[type="text-edit"] {
	background: transparent;
	border: none;
	color: #1a1a1a;
}

QScrollBar:vertical {
	background-color: #f0f0f0;
	width: 8px;
}
QScrollBar::handle:vertical {
	background-color: #c0c0c0;
	border-radius: 4px;
	min-height: 20px;
}
QScrollBar::handle:vertical:hover {
	background-color: #f1f0ef;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
	height: 0px;
}

QSplitter::handle {
	background-color: #d0d0d0;
}
QSplitter::handle:hover {
	background-color: #f1f0ef;
}
QSplitter::handle:pressed {
	background-color: #aaaaaa;
}

ViewSidebar {
	background-color: #f9f8f7;
}

ViewReviewTag {
	border: 1px solid #d0d0d0;
}
ViewReviewTag:hover {
	background-color: #f1f0ef;
}
ViewReviewTag:pressed {
	background-color: #d8d8d8;
}

QuestionEdit {
	border: 1px solid #c0c0c0;
	background: transparent;
}

QCheckBox {
	color: #1a1a1a;
}

QPushButton#add-new-note {
	background-color: #e8e8e8;
	color: #1a1a1a;
}
QPushButton#add-new-note:hover {
	background-color: #f1f0ef;
	background-image: none;
}
