/* ===== MAIN.QSS — Chỉ chứa layout, font, kích thước. Màu sắc nằm ở dark.qss / light.qss ===== */

QPushButton {
	/* Trên dưới 8px, Trái phải 16px */
	padding: 8px 16px;

	/* Cỡ chữ 10pt */
	font-size: 10pt;

	/* Bo góc mềm mại */
	border-radius: 8px;

	font-weight: bold;
}
QPushButton[type="sidebarButton"] {
	text-align: left;
}
QPushButton[type="iconButton"] {
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    padding: 0px;
    font-size: 10pt;
    border-radius: 8px;
}
QPushButton::menu-indicator {
	image: none;
	width: 0px;
}

QLabel {
    font-family: "Segoe UI", "Roboto", sans-serif;
    font-size: 16px;
}
QLabel[type="title"] {
    font-weight: bold;
    font-size: 30px;
    margin: 8px;
}
QLabel[type="sidebar-title"] {
	font-weight: bold;
	margin-top: 8px;
}
QLabel[type="chapter-title"] {
	font-weight: bold;
	font-size: 20px;
	padding-top: 4px;
	padding-bottom: 4px;
}
QLabel[type="path"] {
	font-size: 11px;
	background-color: transparent;
}
QLabel[type="brief"] {
	margin: 4px;
}

QMenu {
    font-family: "Segoe UI", "Roboto", sans-serif;
    font-size: 16px;
    icon-size: 16px;
}

ViewReviewTag {
	border-radius: 8px;
}

ViewNoteBlock {
	margin: 0px;
}

QListWidget {
	font-family: "Segoe UI", "Roboto", sans-serif;
	font-size: 14px;
	font-weight: bold;
}
QListWidget[type="trash-page"] {
	font-size: 24px;
	padding-bottom: 4px;
}

QComboBox {
	font-family: "Segoe UI", "Roboto", sans-serif;
	font-size: 16px;
}

QLineEdit[type="chapter-title"] {
    font-family: "Segoe UI", "Roboto", sans-serif;
	font-weight: bold;
	font-size: 20px;
	border: none;
	background: transparent;
	padding-top: 4px;
	padding-bottom: 4px;
}
QLineEdit[type="input-dialog"] {
	border: none;
	background: transparent;
}

QPlainTextEdit {
    font-family: "Segoe UI", "Roboto", sans-serif;
    font-size: 16px;
}

QSplitter::handle {
	width: 4px;
}

ViewSidebar {
	margin: 0px;
}

QuestionEdit {
	border-radius: 8px;
}

QScrollArea {
	border: none;
}

QPlainTextEdit[type="text-edit"] {
	border: none;
	background: transparent;
}
